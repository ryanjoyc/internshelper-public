# internsHELPer per-machine settings. Run `.venv/bin/python -m internshelper.setup`
# to create `.env` with owner-only permissions; never commit the populated file.

# Email is optional and disabled by default. Use an app-specific SMTP password.
INTERNSHELPER_SMTP_SENDER=
INTERNSHELPER_SMTP_RECIPIENT=
INTERNSHELPER_SMTP_PASSWORD=

# Feature toggles (1 = enabled, 0 = disabled).
INTERNSHELPER_FEATURE_COLLECT=1
INTERNSHELPER_FEATURE_EMAIL=0
INTERNSHELPER_FEATURE_AVAILABILITY=1
INTERNSHELPER_FEATURE_SCHEDULE=0
INTERNSHELPER_FEATURE_DASHBOARD=1
INTERNSHELPER_FEATURE_APP=0

# Optional absolute paths for keeping mutable files outside the checkout.
# INTERNSHELPER_DB=/path/to/internshelper.db
# INTERNSHELPER_SOURCES=/path/to/sources.yaml
# INTERNSHELPER_SETTINGS=/path/to/settings.toml
# INTERNSHELPER_COMPANIES=/path/to/companies.yaml
# INTERNSHELPER_COMPANY_GROUPS=/path/to/company-groups.yaml
# INTERNSHELPER_PROFILE=/path/to/profile.md
